@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@model IEnumerable<toDoAPP.Models.Task>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
<link rel="stylesheet" href="~/css/tasklist.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Görev Listesi</h3>
        <a href="/Task/AddTask" class="btn btn-primary custom-add-task-btn">
            <i class="bi bi-plus-circle-fill me-2"></i> Görev Ekle
        </a>
    </div>

    <div class="card mb-4 p-3">
        <h5>Filtrele</h5>
        <div class="row g-3">
            <div class="col-md-4">
                <label for="filterTaskName" class="form-label">Başlık</label>
                <input type="text" class="form-control" id="filterTaskName" placeholder="Başlık ara">
            </div>
            <div class="col-md-4">
                <label for="filterCategory" class="form-label">Kategori</label>
                <input type="text" class="form-control" id="filterCategory" placeholder="Kategori ara">
            </div>
            <div class="col-md-4">
                <label for="filterPrecedence" class="form-label">Öncelik</label>
                <select class="form-select" id="filterPrecedence">
                    <option value="">Tümü</option>
                    <option value="Düşük">Düşük</option>
                    <option value="Orta">Orta</option>
                    <option value="Yüksek">Yüksek</option>
                </select>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table custom-rounded-table caption-top">
            <caption>Görevlerinizi buradan takip edebilirsiniz.</caption>
            <thead class="custom-table-header">
                <tr>
                    <th scope="col">Başlık</th>
                    <th scope="col">Açıklama</th>
                    <th scope="col">Son Tarih</th>
                    <th scope="col">Öncelik</th>
                    <th scope="col">Kategori</th>
                    <th scope="col">Görev Durumu</th>
                    <th scope="col">İşlemler</th>
                </tr>
            </thead>
            <tbody id="taskListTableBody">
                @foreach (var item in Model)
                {
                    <tr class="custom-table-row">
                        <td data-taskname="@item.TaskName">@item.TaskName</td>
                        <td>@item.Description</td>
                        <td>@item.LastDate</td>
                        <td data-precedence="@item.Precedence">@item.Precedence</td>
                        <td data-category="@item.Category">@item.Category</td>
                        <td data-category="@item.IsCompleted">
                            @(item.IsCompleted ? "Tamamlandı" : "Tamamlanmadı")
                        <td>
                        <td>
                            <div class="task-actions">
                                <a href="/Task/UpdateTask/@item.TaskId" class="btn btn-sm btn-warning me-2">
                                    <i class="bi bi-pencil-fill"></i> Güncelle
                                </a>
                                <a href="/Task/DeleteTask/@item.TaskId" class="btn btn-sm btn-danger"
                                   onclick="return confirm('Bu görevi silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.');">
                                    <i class="bi bi-trash-fill"></i> Sil
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const filterTaskName = document.getElementById('filterTaskName');
        const filterCategory = document.getElementById('filterCategory');
        const filterPrecedence = document.getElementById('filterPrecedence');
        const tableBody = document.getElementById('taskListTableBody');
        const rows = tableBody.querySelectorAll('tr');

        function applyFilters() {
            const taskNameValue = filterTaskName.value.toLowerCase();
            const categoryValue = filterCategory.value.toLowerCase();
            const precedenceValue = filterPrecedence.value;

            rows.forEach(row => {
                const taskName = row.querySelector('td:nth-child(1)').textContent.toLowerCase();
                const precedence = row.querySelector('td:nth-child(4)').textContent;
                const category = row.querySelector('td:nth-child(5)').textContent.toLowerCase();

                const matchesTaskName = taskName.includes(taskNameValue);
                const matchesCategory = category.includes(categoryValue);
                const matchesPrecedence = (precedenceValue === "" || precedence === precedenceValue);

                if (matchesTaskName && matchesCategory && matchesPrecedence) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        filterTaskName.addEventListener('keyup', applyFilters);
        filterCategory.addEventListener('keyup', applyFilters);
        filterPrecedence.addEventListener('change', applyFilters);
    });
</script>