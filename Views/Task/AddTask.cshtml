@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@model toDoAPP.Models.Task;
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Görev Formu</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body>

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">Görev Oluştur</h4>
                    </div>
                    <div class="card-body">
                        <form asp-action="AddTask" asp-controller="Task" method="post">
                            <div class="mb-3">
                                <label for="taskName" class="form-label">Görev Adı</label>
                                <input type="text" class="form-control" id="taskName" name="TaskName" placeholder="Görevin adını girin" required>
                            </div>
                            <input type="hidden" asp-for="isCompleted" id="isCompleted" name="isCompleted" value="false" />
                            <div class="mb-3">
                                <label for="description" class="form-label">Açıklama</label>
                                <textarea class="form-control" id="description" name="Description" rows="4" placeholder="Görevin detaylı açıklamasını girin"></textarea>
                            </div>
                            <div class="mb-3">
                                <label for="lastDate" class="form-label">Son Tarih</label>
                                <input type="date" class="form-control" id="lastDate" name="LastDate" required>
                            </div>
                            <div class="mb-3">
                                <label for="precedence" class="form-label">Öncelik</label>
                                <select class="form-select" id="precedence" name="Precedence" required>
                                    <option selected disabled value="">Seçiniz...</option>
                                    <option value="Yuksek">Yüksek</option>
                                    <option value="Orta">Orta</option>
                                    <option value="Dusuk">Düşük</option>
                                </select>
                            </div>
                            <div class="mb-4">
                                <label for="category" class="form-label">Kategori</label>
                                <input type="text" class="form-control" id="category" name="Category" placeholder="Örn: İş, Kişisel, Eğitim">
                            </div>
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg" onclick="return validateAndConfirmDate();">Görevi Kaydet</button>
                                <button type="reset" class="btn btn-outline-secondary">Temizle</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>

<script>
    function validateAndConfirmDate() {
        const lastDateInput = document.getElementById('lastDate');
        const selectedDateValue = lastDateInput.value;

        if (!selectedDateValue) {
            return true;
        }

        const selectedDate = new Date(selectedDateValue);
        const today = new Date();
        today.setHours(0, 0, 0, 0); 

        if (selectedDate < today) {
            return confirm('Seçilen tarih mevcut günden daha eski olamaz. Devam etmek istiyor musunuz? (İptal ederseniz form gönderilmez)');
        } else {
            return true;
        }
    }
</script>