@model toDoAPP.Models.Task;
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@{
    ViewData["Title"] = "UpdateTask";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Görev Formu</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Görev Güncelle</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" asp-controller="Task" method="post">

                        <input type="hidden" asp-for="taskId" id="taskId" name="TaskId" value="@Model.TaskId" />

                        <div class="mb-3">
                            <label for="taskName" class="form-label">Görev Adı</label>
                            <input type="text" value="@Model.TaskName" class="form-control" id="taskName" name="TaskName" placeholder="Görevin adını girin" required>
                        </div>
                        <div class="mb-3">
                            <label for="description" class="form-label">Açıklama</label>
                            <textarea class="form-control" id="description" name="Description" rows="4">@Model.Description</textarea>
                        </div>

                        <div class="mb-3">
                            <label for="lastDate" class="form-label">Son Tarih</label>
                            <input type="date" class="form-control" value="@Model.LastDate.ToString("yyyy-MM-dd")" id="lastDate" name="LastDate" required>
                        </div>

                        <div class="mb-3">
                            <label for="precedence" class="form-label">Öncelik</label>
                            <select class="form-select" id="precedence" name="Precedence" required>
                                <option disabled value="">Seçiniz...</option>
                                <option value="Yüksek" @(Model.Precedence == "Yüksek" ? "selected" : "")>Yüksek</option>
                                <option value="Orta" @(Model.Precedence == "Orta" ? "selected" : "")>Orta</option>
                                <option value="Düşük" @(Model.Precedence == "Düşük" ? "selected" : "")>Düşük</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Durum</label><br />
                            <div class="form-check form-check-inline">
                                <input type="radio" id="isCompleted" name="IsCompleted" class="form-check-input" value="true">
                                <label class="form-check-label" for="isCompleted">Tamamlandı</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input type="radio" id="isCompleted" name="IsCompleted" class="form-check-input" value="false" >
                                <label class="form-check-label" for="isCompleted">Tamamlanmadı</label>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label for="category" class="form-label">Kategori</label>
                            <input type="text" value="@Model.Category" class="form-control" id="category" name="Category" placeholder="Örn: İş, Kişisel, Eğitim">
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">Görevi Güncelle</button> <a href="javascript:history.back()" class="btn btn-outline-secondary">Geri Dön</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
</html>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
